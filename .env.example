# --- Backend ---
# Async connection string used by the FastAPI app.
# Host "db" is the docker-compose service name.
DATABASE_URL=postgresql+asyncpg://gophkeeper:gophkeeper@db:5432/gophkeeper

# Host port the API is published on (the container always listens on 8000).
# Set to 80 when deploying on the course VM so http://<vm> works directly.
API_PORT=8000

# --- JWT Settings ---
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- PostgreSQL (must match the credentials inside DATABASE_URL) ---
POSTGRES_USER=gophkeeper
POSTGRES_PASSWORD=gophkeeper
POSTGRES_DB=gophkeeper

# --- CLI client (optional; read by cli.py, not the server) ---
# Base URL the CLI talks to.
# GOPHKEEPER_SERVER=http://localhost
# Config dir for the CLI's token + local cache. Use a different dir per client
# to run two clients side by side (two-client demo), e.g.:
#   GOPHKEEPER_HOME=~/.gk-alice python cli.py login
#   GOPHKEEPER_HOME=~/.gk-bob   python cli.py login
# GOPHKEEPER_HOME=~/.gophkeeper
